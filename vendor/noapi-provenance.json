 "patches": [
  {
   "path": "build.zig",
   "original_sha256": "2fc80a05cbdc4821bdd86308ca06a1e5abe1e1c09792c9bc7d017e6fb04bba75",
   "current_sha256": "7c36e8fdeee6c1830bd2cdc7c098f20567604a20422e739984451b84e9966644",
   "reason": "Build the vendored tree as an SDL-free library: drop the sdl3 module import, declare sdl3 as a lazy dependency, add a -Dlibrary-only option that stops before the examples, register the test step first, stop installing generated documentation, and support focused unit-test filters. Port to Zig 0.17.0."
  },
  {
   "path": "build.zig.zon",
   "original_sha256": "3d47c675b7f189ffbd315727738090b9cd465772ab52dcbe96cfeb5ea039f73e",
   "current_sha256": "167ee65f6514a60b99a4999ba9368c53a6385e927bc92613977ff0de053d0df9",
   "reason": "Mark the sdl3 dependency lazy so the library-only build stops before it is fetched or built. Package the MIT license, third-party notices, and generated sky asset source. Port to Zig 0.17.0."
  },
  {
   "path": "examples/2_textures/main.zig",
