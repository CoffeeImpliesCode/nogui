+/*
+ * Daemon -> module write audit sideband.
+ *
+ * Off unless NOGUI_MODULE_OBSERVER_META names a file.  When it is on, one
+ * fixed size record per daemon -> module write states how many bytes the
+ * kernel actually moved, at which offset in the stream of which physical
+ * pipe, for which message.  The record carries no payload byte, no text and
+ * no clock, and it can never change what the write itself does.
+ */
+#define AUDIT_LINE_MAX 1024
+#define AUDIT_BOOT_ID_MAX 64
+
+/* audit_state: 0 untouched, 1 armed, 2 permanently inert for this daemon. */
+static int audit_state;
+static int audit_fd = -1;	/* the ONE descriptor, for the daemon lifetime */
+static unsigned int audit_epoch;	/* one bump per native module instance */
+static unsigned int audit_daemon_pid;
+static unsigned long long audit_daemon_pticks;
+static char audit_boot_id[AUDIT_BOOT_ID_MAX];
+static pthread_mutex_t audit_mutex = PTHREAD_MUTEX_INITIALIZER;
