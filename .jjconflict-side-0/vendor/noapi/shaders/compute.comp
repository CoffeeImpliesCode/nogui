#version 460
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, rgba8, binding = 0) uniform writeonly image2D outputImage;

layout(push_constant) uniform PushConstants {
    float time;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outputImage);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = vec2(coord) / vec2(size);
    float r = sin(uv.x * 10.0 + pc.time) * 0.5 + 0.5;
    float g = cos(uv.y * 10.0 + pc.time) * 0.5 + 0.5;
    float b = sin((uv.x + uv.y) * 5.0 + pc.time * 0.7) * 0.5 + 0.5;
    imageStore(outputImage, coord, vec4(r, g, b, 1.0));
}
