#version 460
#extension GL_EXT_buffer_reference : require
#extension GL_ARB_gpu_shader_int64 : require

layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 1, rgba8, binding = 0) uniform writeonly image2D outputImage;

struct QuadCurve {
    vec2 p0;
    vec2 p1;
    vec2 p2;
};

layout(buffer_reference, buffer_reference_align = 16) buffer CurveBuf {
    uint num_curves;
    uint pad;
    QuadCurve curves[];
};

layout(push_constant) uniform Push {
    uint64_t curve_addr;
} pc;

// ── Intersection helpers (from paper §8.2) ──────────────────
// Solve qa*t^2 + qb*t + qc = 0 for a monotonic quadratic.
// c0 = p0.coord, c1 = p1.coord, c2 = p2.coord
// Only one root is in [0,1] due to monotonicity.
float intersectMonotonic(float qa, float c0, float c1, float c2, float target) {
    if (abs(qa) < 1e-10) {
        // Nearly linear — fallback
        float qb = 2.0 * (c1 - c0);
        if (abs(qb) < 1e-10) return 0.0;
        return (target - c0) / qb;
    }
    float qb = 2.0 * (c1 - c0);
    float qc = c0 - target;
    float d = qb*qb - 4.0*qa*qc;
    float sqrt_d = d < 0.0 ? 0.0 : sqrt(d);
    float inv_2a = 0.5 / qa;
    return -qb * inv_2a + sign(c2 - c0) * sqrt_d * inv_2a;
}

vec2 evalBez(vec2 p0, vec2 p1, vec2 p2, float t) {
    float mt = 1.0 - t;
    return mt*mt*p0 + 2.0*mt*t*p1 + t*t*p2;
}

// ── Core sweep (from paper §8.3) ───────────────────────────
// Computes signed area swept by a single monotonic quadratic
// across a pixel-sized window [offset, offset+size].
float scanlineSweep(vec2 size, vec2 offset, vec2 p0, vec2 p1, vec2 p2) {
    // Discard if entirely above or below the scanline window
    if (max(p0.y, p2.y) <= offset.y || min(p0.y, p2.y) >= offset.y + size.y)
        return 0.0;

    vec2 delta = p2 - p0;

    // Shift to window-relative coordinates
    p0 -= offset;
    p1 -= offset;
    p2 -= offset;

    // Fast path: vertical line segments (common in fonts)
    if (p0.x == p1.x && p0.x == p2.x) {
        if (p0.x >= size.x) return 0.0;
        float top = min(max(p0.y, p2.y), size.y);
        float bottom = max(min(p0.y, p2.y), 0.0);
        float h_vert = top - bottom;
        float b_vert = size.x - p0.x;
        return sign(delta.y) * b_vert * h_vert;
    }

    // ── Y-intersections ───────────────────────────────────
    float qa_y = p0.y + p2.y - 2.0 * p1.y;
    float bt = intersectMonotonic(qa_y, p0.y, p1.y, p2.y, 0.0);     // bottom
    float tt = intersectMonotonic(qa_y, p0.y, p1.y, p2.y, size.y);  // top

    float v_min_t = delta.y > 0.0 ? bt : tt;  // earlier t in direction of travel
    float v_max_t = delta.y > 0.0 ? tt : bt;  // later t

    vec2 v_min = evalBez(p0, p1, p2, clamp(v_min_t, 0.0, 1.0));
    vec2 v_max = evalBez(p0, p1, p2, clamp(v_max_t, 0.0, 1.0));

    // Entirely to the left of the window → rectangle from v_min to v_max
    if (max(v_min.x, v_max.x) <= 0.0)
        return (v_max.y - v_min.y) * size.x;

    // Entirely to the right → no area
    if (min(v_min.x, v_max.x) >= size.x)
        return 0.0;

    // ── X-intersections ───────────────────────────────────
    float qa_x = p0.x + p2.x - 2.0 * p1.x;

    float h_min_t, h_max_t;

    // h_check stores: near_x, far_x, target, t_at_near
    vec4 h_check = delta.x > 0.0
        ? vec4(p0.x, p2.x, 0.0, 0.0)       // moving right
        : vec4(p2.x, p0.x, size.x, 1.0);   // moving left

    // Near boundary
    if (h_check.x >= h_check.z)      h_min_t = h_check.w;
    else if (h_check.y <= h_check.z) h_min_t = 1.0 - h_check.w;
    else h_min_t = intersectMonotonic(qa_x, p0.x, p1.x, p2.x, h_check.z);

    // Far boundary
    h_check.z = size.x - h_check.z;
    if (h_check.x >= h_check.z)      h_max_t = h_check.w;
    else if (h_check.y <= h_check.z) h_max_t = 1.0 - h_check.w;
    else h_max_t = intersectMonotonic(qa_x, p0.x, p1.x, p2.x, h_check.z);

    // Clamp to curve domain ∩ window
    float min_t = clamp(max(v_min_t, h_min_t), 0.0, 1.0);
    float max_t = clamp(min(v_max_t, h_max_t), 0.0, 1.0);
    if (min_t >= max_t) return 0.0;

    vec2 q0 = (v_min_t >= h_min_t) ? v_min : evalBez(p0, p1, p2, min_t);
    vec2 q1 = (v_max_t <= h_max_t) ? v_max : evalBez(p0, p1, p2, max_t);

    // ── Signed area ──────────────────────────────────────
    float area = 0.0;

    // Rectangle swept before entering the window from the left
    if (min_t > 0.0 && delta.x > 0.0) {
        float h_rect = delta.y > 0.0
            ? q0.y - max(0.0, p0.y)
            : min(size.y, p0.y) - q0.y;
        area += sign(delta.y) * h_rect * size.x;
    }

    // Rectangle swept after exiting the window on the left
    if (max_t < 1.0 && delta.x < 0.0) {
        float h_rect = delta.y > 0.0
            ? min(size.y, p2.y) - q1.y
            : q1.y - max(0.0, p2.y);
        area += sign(delta.y) * h_rect * size.x;
    }

    // Trapezoidal quadrature for the portion within the window
    float h_trap = q1.y - q0.y;
    float b_trap = size.x - 0.5 * (q0.x + q1.x);
    area += b_trap * h_trap;

    return area;
}

// ── Main ──────────────────────────────────────────────────
void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size_tex = imageSize(outputImage);
    if (coord.x >= size_tex.x || coord.y >= size_tex.y) return;

    CurveBuf buf = CurveBuf(pc.curve_addr);
    uint n = buf.num_curves;

    // Pixel window in FreeType Y-up space.
    // Texture Y-down → FreeType Y-up: free_y = size_tex.y - 1 - tex_y
    // The pixel covers 1x1 units.
    vec2 offset = vec2(
        float(coord.x),
        float(size_tex.y - 2 - coord.y)  // lower-left corner
    );
    vec2 win_size = vec2(1.0, 1.0);

    float total_area = 0.0;
    for (uint i = 0u; i < n; i++) {
        QuadCurve c = buf.curves[i];
        total_area += scanlineSweep(win_size, offset, c.p0, c.p1, c.p2);
    }

    // Coverage = signed area / window area (which is 1.0 for a 1x1 pixel)
    float coverage = clamp(total_area, 0.0, 1.0);
    imageStore(outputImage, coord, vec4(coverage, coverage, coverage, 1.0));
}
